    "version": "1.0.3",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 1080 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "1920x1080",
            "path": [
                "./resource"
            ]
        }

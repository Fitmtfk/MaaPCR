{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaPCR",
    "description": "这是一个使用 MaaFramework 创建的公主连结自动化工具。",
    "contact": "无",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAAPCR!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/Fitmtfk/MaaPCR",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 1080 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "1920x1080",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    "agent": {
        "child_exec": "./python/python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "黎明界刷开局",
            "entry": "黎明界主页"
        }
    ]
}